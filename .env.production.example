# ===========================
# Production Environment Configuration
# ===========================
# Copy this file to .env and configure with your production values
# IMPORTANT: Generate secure random values for secrets using: openssl rand -hex 32

NODE_ENV=production

# ===========================
# Application Settings
# ===========================
# The fully qualified public URL of your Outline instance
URL=https://your-domain.com

# Port the application will run on (default: 6700)
PORT=6700

# For separate collaboration server (optional, advanced usage)
COLLABORATION_URL=

# CDN URL for static assets (optional)
CDN_URL=

# Number of processes to spawn (divide available memory by 512MB as rough estimate)
WEB_CONCURRENCY=2

# ===========================
# Security (REQUIRED)
# ===========================
# Generate with: openssl rand -hex 32
SECRET_KEY=
UTILS_SECRET=

# Default language
DEFAULT_LANGUAGE=en_US

# ===========================
# Database (Postgres)
# ===========================
# When using docker-compose, these should match the postgres service configuration
POSTGRES_USER=outline
POSTGRES_PASSWORD=outline_password
POSTGRES_DB=outline

# Full database URL (auto-configured in docker-compose)
DATABASE_URL=postgres://outline:outline_password@postgres:5432/outline

# Connection pool settings (optional)
DATABASE_CONNECTION_POOL_MIN=
DATABASE_CONNECTION_POOL_MAX=

# Disable SSL for database if on same machine/network
PGSSLMODE=disable

# ===========================
# Redis
# ===========================
REDIS_URL=redis://redis:6379

# ===========================
# File Storage
# ===========================
# Use "local" for filesystem storage or "s3" for S3-compatible storage
FILE_STORAGE=local

# For local storage
FILE_STORAGE_LOCAL_ROOT_DIR=/var/lib/outline/data
FILE_STORAGE_UPLOAD_MAX_SIZE=262144000

# For S3 storage (if FILE_STORAGE=s3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_UPLOAD_BUCKET_URL=
# AWS_S3_UPLOAD_BUCKET_NAME=
# AWS_S3_FORCE_PATH_STYLE=false
# AWS_S3_ACL=private

# ===========================
# SSL/HTTPS
# ===========================
# Auto-redirect to HTTPS (set false if SSL terminated at load balancer/reverse proxy)
FORCE_HTTPS=false

# Base64 encoded SSL certificate (optional, if not using reverse proxy)
SSL_KEY=
SSL_CERT=

# ===========================
# Authentication (at least ONE required)
# ===========================

# Slack OAuth
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra / Azure AD
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_RESOURCE_APP_ID=

# Discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_SERVER_ID=

# Generic OIDC
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUTH_URI=
OIDC_TOKEN_URI=
OIDC_USERINFO_URI=
OIDC_LOGOUT_URI=
OIDC_USERNAME_CLAIM=preferred_username
OIDC_DISPLAY_NAME=OpenID Connect
OIDC_SCOPES=openid profile email

# ===========================
# Email (SMTP)
# ===========================
SMTP_SERVICE=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# ===========================
# Rate Limiting
# ===========================
RATE_LIMITER_ENABLED=true
RATE_LIMITER_REQUESTS=1000
RATE_LIMITER_DURATION_WINDOW=60

# ===========================
# Integrations (Optional)
# ===========================

# GitHub integration
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Linear integration
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# Notion import
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Slack integration (beyond auth)
SLACK_VERIFICATION_TOKEN=
SLACK_APP_ID=
SLACK_MESSAGE_ACTIONS=false

# Sentry error tracking
SENTRY_DSN=
SENTRY_TUNNEL=

# ===========================
# Debugging & Monitoring
# ===========================
ENABLE_UPDATES=true
DEBUG=http
LOG_LEVEL=info
