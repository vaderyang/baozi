# ---- 必填：基础 ----
URL=https://house.netis.com
SECRET_KEY=
UTILS_SECRET=
#FORCE_HTTPS=false

# ---- 必填：数据库/缓存（与下方 compose 配套）----
#DATABASE_URL=postgres://user:pass@postgres:5432/outline
DATABASE_URL=postgres://user:pass@postgres:5432/outline?sslmode=disable
REDIS_URL=redis://redis:6379

# ---- 登录方式：至少配置一种（通用 OIDC 示例）----
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUTH_URI=http://oidc.netis.com/realms/master/protocol/openid-connect/auth
OIDC_TOKEN_URI=http://oidc.netis.com/realms/master/protocol/openid-connect/token
OIDC_USERINFO_URI=http://oidc.netis.com/realms/master/protocol/openid-connect/userinfo
OIDC_SCOPES=openid profile email
OIDC_DISPLAY_NAME=Company SSO
# OIDC_DISABLE_REDIRECT=true
OIDC_LOGOUT_URI=http://oidc.netis.com/realms/master/protocol/openid-connect/logout

# ---- 统一管理 https-portal 配置 ----
# 端口映射（宿主机端口）
HTTP_PORT=80
HTTPS_PORT=443
# 站点域名到 Outline 容器的映射，支持多域名以逗号分隔
DOMAINS=house.netis.com -> http://outline:3000
# 证书申请阶段：local（自签）/ production（申请真实证书，需要公网可校验）
STAGE=local
# 启用 websocket 代理
WEBSOCKET=true
# 上传大小限制，0 表示不限制
CLIENT_MAX_BODY_SIZE=0
